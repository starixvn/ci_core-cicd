{#-------------------Variables--------------------#}
{% set service_name = services[0].name | replace('-','_') %}
{% set env = '@DEPLOY_ENVIRONMENT' | lower %}
{% set environment = env | upper ~ '@DEPLOY_VERSION' %}

{#---------replica_count---------#}
{% set replicas_name = 'number_of_replicas_' ~ env %}
{% set replicas = services[0][replicas_name] | default(1) | int %}

{% if env in ["prod","alphaprod","fpsprod","awsprod"] %}
  {% set replica_count = [services[0].number_of_replicas_prod | default(1) | int, 6] | min %}
{% else %}
  {% set replica_count = [replicas, 2] | min %}
{% endif %}
{#---------end replica_count---------#}

{#---------max_unavailable---------#}
{% set update_order = services[0].update_order | default('start-first', true) %}
{% set max_unavailable = 0 if update_order == 'start-first' else '1' %}
{#---------end max_unavailable---------#}

{#---------enable_health_check---------#}
{% set disable_health_check = services[0].disable_health_check | default(false) %}
{% set enable_health_check = (true if not disable_health_check or disable_health_check == 'false' else false) | lower %}
{#---------end enable_health_check---------#}

{#---------container_port---------#}
{% set container_port = services[0].port | default(5000) %}
{#---------end container_port---------#}

{#---------limit_memory---------#}
{% set limit_memory = services[0].max_memory | default(2048) | int %}
{% set limit_memory = [limit_memory,1024] | max %}
{% set limit_memory = [limit_memory,12000] | min %}
{#---------end limit_memory---------#}

{#---------config_file---------#}
{% if services[0].config_file_name is defined and services[0].config_file_ext | length > 0 %}
  {% set config_file = services[0].config_file_name ~ '.' ~ services[0].config_file_ext %}
{% else %}
  {% set config_file = services[0].config_file_name %}
{% endif %}

{% set container_root_path = services[0].container_root_path | default ('/app') %}
{% set config_container_path = services[0].config_container_path | default ('.') %}
{#---------end config_file---------#}

{#---------sp_file---------#}
{% if services[0].sp_file_name is defined and services[0].sp_file_name != '' %}
  {% set sp_file = services[0].sp_file_name ~ '.' ~ services[0].sp_file_extension | default("xml") %}
  {% set sp_container_path = services[0].sp_container_path | default ('App_Data') %}
{% endif %}
{#---------end sp_file---------#}

{#---------node_label---------#}
{% if services[0].node_labels is defined and services[0].node_labels | length > 0 %}
  {% set node_label = services[0].node_labels[0] | replace('_','-') | lower %}
{% else %}
  {% set node_label = (org_name ~ '-app') | lower %}
{% endif %}
{#---------end node_label---------#}

############# k8s deployments values #############
replicaCount: {{ replica_count }}
revisionHistoryLimit: 5

rollingUpdate:
  maxSurge: 25%
  maxUnavailable: {{ max_unavailable }}

image:
  name: "@REGISTRY_IMAGE/{{team_name}}/{{project_name}}_{{service_name}}:{{environment}}-latest"
  pullPolicy: Always

healthCheck:
  enabled: {{ enable_health_check }}
  path: {{services[0].healthcheck_path | default('/')}}
  failureThreshold: {{services[0].healthcheck_retries | default(5)}}
  periodSeconds: {{services[0].healthcheck_interval | default(5) | replace('s','')}}
  timeoutSeconds: {{services[0].healthcheck_timeout | default(5) | replace('s','')}}
  startupFailureThreshold: 30

{% if config_file is defined %}
configFile:
  path: "{{ container_root_path }}/{{ config_container_path }}"
  name: "{{ config_file }}"    
{% endif %}

{% if sp_file is defined %}
spFile:
  path: "{{container_root_path}}/{{sp_container_path}}"
  name: "{{sp_file}}"    
{% endif %}

{% if org_name == "luminet" %}
env:
  - name: APP_NAME
    value: "{{ service_name }}"
{% endif %}

service:
# kind of types: ClusterIP, NodePort, LoadBalancer
  type: ClusterIP
  port: {{ container_port }}
  targetPort: {{ container_port }}
#  nodePort:

{% if site_urls is defined and site_urls | length > 0 %}
ingress:
  enabled: true
  hosts:
  {% for url in site_urls %}
    - host: {{ url.host }}
      paths:
        - path: {{ url.path }}
          pathType: Prefix
  {% endfor %}
{% endif %}

resources:
  limits:
    memory: {{ limit_memory }}Mi
  requests:
    memory: 16Mi

serviceAccount:
  # Specifies whether a service account should be created
  create: false
  # Annotations to add to the service account
  annotations: {}

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 100
  targetCPUUtilizationPercentage: 80
  # targetMemoryUtilizationPercentage: 80

nodeSelector:
  {{node_label}}: "yes"

tolerations: []

affinity: {}

podAnnotations: {}

podSecurityContext: {}
  # fsGroup: 2000

securityContext: {}
  # capabilities:
  #   drop:
  #   - ALL
  # readOnlyRootFilesystem: true
  # runAsNonRoot: true
  # runAsUser: 1000