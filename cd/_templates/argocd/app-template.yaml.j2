apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: @STACK_NAME-@APP_NAME-@ENV_NAME
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  labels:
    app: @STACK_NAME-@APP_NAME
spec:
  destination:
    namespace: @STACK_NAME
    name: @ARGO_CLUSTER
  project: rocketor
  source:
    path: charts
    repoURL: @SRC_REPO_URL
    targetRevision: main
    helm:
      valueFiles:
        - values-@ENV_NAME.yaml
  {% if "@APP_NAME" == "namespace-imagepullsecrets" %}
  ignoreDifferences:
  - kind: Namespace
    jsonPointers:
    - /metadata/annotations/argocd.argoproj.io~1tracking-id
  - kind: Secret
    jsonPointers:
    - /metadata/annotations/argocd.argoproj.io~1tracking-id
  {% endif %}
