apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: @STACK_NAME-@APP_NAME-@ENV_NAME
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  labels:
    app: @APP_NAME
spec:
  destination:
    namespace: @STACK_NAME
    name: @DEST_NAME
  project: default
  source:
    path: charts/@SRC_PATH
    repoURL: @SRC_REPO_URL
    targetRevision: @SRC_TARGET_REVISION
    helm:
      valueFiles:
        - values-@ENV_NAME.yaml
