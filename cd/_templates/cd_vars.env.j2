{% set service_name = services[0].name | replace('-','_') %}
{% set platform = services[0].platform | default('linux') %}
{% set separator_char = '/' if platform == "linux" else '\\' %}
{% if services[0].config_file_name is defined %}
{% if services[0].config_file_ext | length > 0 %}
{% set config_file = services[0].config_file_name ~ '.' ~ services[0].config_file_ext %}
{% else %}
{% set config_file = services[0].config_file_name %}
{% endif %}
{% endif %}
PROJECT_ROOT_PATH={{services[0].root_path | default(".")}}
WORKING_PATH=/var/www/gluster/web/{{team_name}}/{{project_name}}/{{service_name}}
STACK_NAME={{project_name}}
SERVICE_NAME={{project_name}}_{{service_name}}
APP_NAME={{service_name}}
DOCKER_IMAGE_PATH={{team_name}}/{{project_name}}_{{service_name}}
DOCKER_IMAGE_PATH_LOCAL={{team_name}}/{{project_name}}_{{service_name}}
DOCKER_FILE_PATH={{services[0].docker_file_path | default(".")}}
DOCKER_FILE_NAME={{services[0].docker_file_name | default("Dockerfile")}}
{% if services[0].sp_file_name is defined and services[0].sp_file_name != '' %}
SP_FILE_PATH={{services[0].sp_file_path | default("./App_Data") | replace(separator_char,'/') }}
SP_FILE_NAME={{services[0].sp_file_name}}
SP_FILE_EXTENSION={{services[0].sp_file_extension | default("xml")}}
SP_FILE_TRANSFORM={{services[0].sp_mapper | default("false") | lower}}
{% endif %}
CONFIG_FILE_PATH={{services[0].config_file_path | default(".") | replace(separator_char,'/') }}
{% if services[0].config_file_name is defined %}
CONFIG_FILE_NAME={{ services[0].config_file_name }}
{% if services[0].config_file_ext | length > 0 %}
CONFIG_FILE_EXTENSION={{ services[0].config_file_ext }}
{% endif %}
{% endif %}
{% if clusters is defined and clusters | length == 1 %}
DEPLOYMENT_API={{ clusters[0].deploy_api_link }}
REGISTRY_IMAGE={{ clusters[0].registry }}
SERVER_IP={{ clusters[0].server_ip }}
SERVER_USER={{ clusters[0].ssh_user }}
SERVER_PORT={{ clusters[0].ssh_port }}
{% endif %}
{% if site_urls is defined and site_urls | length > 0 %}
ENABLE_INGRESS=true
{% endif %}