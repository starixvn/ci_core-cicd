{% for item in clusters %}
{% set has_argo_cluster = item.argo_cluster | length > 0 %}
deploy_{{ item.type }}{% if has_argo_cluster %}_argocd{% endif %}_{{ item.name | lower | replace(' ', '') }}:
  variables:
    DEPLOYMENT_API: {{ item.deploy_api_link }}
    ARGO_CLUSTER: {{ item.argo_cluster }}
    REGISTRY_IMAGE: {{ item.registry }}
    SERVER_IP: {{ item.server_ip }}
    SERVER_USER: {{ item.ssh_user }}
    SERVER_PORT: {{ item.ssh_port }}
  needs: ["prepare_vars"]
  extends:
  {% if item.type == "swarm" %}
    - .base_deploy_stack_swarm
  {% elif has_argo_cluster %}
    - .base_deploy_k8s_argocd
  {% else %}
    - .base_deploy_k8s
  {% endif %}

{% endfor %}