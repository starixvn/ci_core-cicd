apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: @SERVICE_NAME_@ENV_NAME
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  destination:
    namespace: @STACK_NAME
    server: https://kubernetes.default.svc
  project: default
  source:
    path: charts/@SRC_PATH
    repoURL: @SRC_REPO_URL
    targetRevision: @SRC_TARGET_REVISION
    helm:
      valueFiles:
        - values_@ENV_NAME.yaml
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true 