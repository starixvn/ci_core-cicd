############# shared-configmaps values #############
shared-configmaps:
  {% if files is defined and files | length > 0 %}
  configFiles:
  {% for file in files %}
    {% if file.content | length > 1 %}
    - name: "{{ file.name }}"
      content: |
        {{ file.content | indent(8) }}
    {% endif %}
  {% endfor %}
  {% endif %}
